# Django settings
SECRET_KEY=change-this-in-production
DEBUG=True

# Public site URL used to build canonical, Open Graph, and sitemap.xml URLs.
#
# DOMAIN SWITCH PROCEDURE:
# When stopdepotsauvage.beta.gouv.fr becomes the primary served domain:
#   1. Set SITE_BASE_URL to https://stopdepotsauvage.beta.gouv.fr
#   2. Set up permanent (301) path-by-path redirects from protect-envi
#   3. Re-submit sitemap.xml in Search Console for the new domain.
#SITE_BASE_URL=https://protect-envi.beta.gouv.fr

# CORS settings
#CORS_ALLOWED_ORIGINS=

# CSRF settings
#CSRF_TRUSTED_ORIGINS=

# Security & CSP
#SECURE_BROWSER_XSS_FILTER=True
#SECURE_CONTENT_TYPE_NOSNIFF=True
#CSP_REPORT_ONLY=True
#CSP_DEFAULT_SRC="'self'"
#CSP_STYLE_SRC="'self','unsafe-inline'"
#CSP_SCRIPT_SRC="'self',https://stats.beta.gouv.fr,https://tally.so,https://client.crisp.chat"
#CSP_IMG_SRC="'self',data:,https://stats.beta.gouv.fr,https://tally.so,https://image.crisp.chat"
#CSP_FONT_SRC="'self',data:"
#CSP_FRAME_SRC="'self',https://tally.so,https://grist.numerique.gouv.fr"
#CSP_CONNECT_SRC="'self',https://stats.beta.gouv.fr,https://client.crisp.chat,wss://client.relay.crisp.chat,https://api.iconify.design"

# Storage / Clever Cloud Cellar (S3 compatible)
#CELLAR_HOST=cellar-c2.services.clever-cloud.com
#CELLAR_KEY_ID=your-key-id
#CELLAR_KEY_SECRET=your-key-secret
#CELLAR_MEDIA_BUCKET_NAME=your-media-bucket-name

# Email
#DEFAULT_FROM_EMAIL="Stop Dépôt Sauvage <contact@stopdepotsauvage.beta.gouv.fr>"
#BREVO_API_KEY=todo
#BREVO_SENDER_DOMAIN=stopdepotsauvage.beta.gouv.fr

# Rate limiting
#THROTTLE_SAFE_RATE=300/m
#THROTTLE_UNSAFE_RATE=60/m

# Gunicorn memory / worker recycling
#GUNICORN_MAX_REQUESTS=500
#GUNICORN_MAX_REQUESTS_JITTER=50

# Frontend settings (VITE_* variables are exposed to the frontend)
VITE_BACKEND_URL=http://localhost:8000
VITE_CONTACT_EMAIL=contact@stopdepotsauvage.beta.gouv.fr
VITE_RDV_PAGE_URL=https://TODO
VITE_LA_POSTE_SUIVI_URL=https://www.laposte.fr/outils/suivre-vos-envois

# Matomo Analytics
VITE_MATOMO_ENABLED=false
VITE_MATOMO_HOST=https://TODO
VITE_MATOMO_SITE_ID=TODO

# Démarche numérique
# VITE_DN_URL=https://demarche.numerique.gouv.fr/commencer/TODO

# ProConnect / OIDC
# VITE_PROCONNECT_ENABLED=true
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# OIDC_OP_AUTHORIZATION_ENDPOINT="https://BASE_URL/api/v2/authorize"
# OIDC_OP_TOKEN_ENDPOINT="https://BASE_URL/api/v2/token"
# OIDC_OP_JWKS_ENDPOINT=
# OIDC_OP_USER_ENDPOINT="https://BASE_URL/api/v2/userinfo"
# OIDC_OP_LOGOUT_ENDPOINT="https://BASE_URL/api/v2/logout"

VITE_LOGIN_REQUIRED=true
# Définir à false pour désactiver le filtrage d'accès (liste blanche SIREN / catégories juridiques) lors des imports ou de la mise en place initiale
# PROCONNECT_ACCESS_RESTRICTIONS_ENABLED=true

# Sentry (Backend)
SENTRY_DSN=
SENTRY_ENABLED=False
SENTRY_DEBUG=False
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=False

# Sentry (Frontend)
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
